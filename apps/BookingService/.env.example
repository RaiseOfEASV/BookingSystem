# Copy this file to .env and fill in values before running docker-compose

# ── Postgres ────────────────────────────────────────────────────────────────
BOOKING_DB=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=your_strong_password

# ── Healthcheck refs (mirror the DB vars above) ──────────────────────────────
MSG_DB=booking_db
MSG_DB_USER=booking_user

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@bookingservice-rabbitmq:5672/
RABBITMQ_SUBSCRIPTION_PREFIX=booking-service
